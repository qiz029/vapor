{
  "name": "@toddzheng024/vapor-vlm-modal",
  "version": "0.3.0",
  "private": true,
  "description": "Version-bound image and sampled-video review through Modal Qwen, with batch approval and durable recovery",
  "type": "module",
  "exports": {
